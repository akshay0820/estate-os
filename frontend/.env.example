# Copy to .env.local (git-ignored) and fill in. Only these two values reach the browser.
# Without them the app runs in an explicitly labelled demo mode with local sample data.

# Project URL, e.g. https://<project-ref>.supabase.co  (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_…) or legacy anon key. Safe for browsers: every request is
# authorized by Row Level Security against the signed-in user's JWT.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service-role key (or any VITE_-prefixed secret) here. The service role is used
# only by the lead-intake Edge Function, where Supabase injects it as SUPABASE_SERVICE_ROLE_KEY.

# Deployment label: production | staging | development. Non-production live builds show a "test data" pill in the app.
# Production builds are refused by `npm run predeploy -- --env production` unless this is `production`.
VITE_APP_ENV=development
