# Edge Function secrets — set them in the Supabase dashboard (Edge Functions → Secrets) or with
#   supabase secrets set NAME=value --project-ref <ref>
# Never commit real values and never prefix them with VITE_. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Agent 02 (voice-calls, voice-webhook, voice-worker): the Retell API key that has the webhook badge.
# Used to place calls and to verify X-Retell-Signature. Without it, calls and webhooks are refused (503).
RETELL_API_KEY=

# Optional: Claude for Agent 01 free-text extraction and Agent 02 post-call analysis. Without it both are skipped.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults: claude-opus-5-5).
INTAKE_MODEL=
VOICE_ANALYSIS_MODEL=
